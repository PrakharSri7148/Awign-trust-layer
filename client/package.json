{
  "name": "trust-layer-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "predev": "node scripts/copy-mediapipe.mjs",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "calibrate": "../backend/.venv/bin/python ../backend/tools/calibrate.py",
    "report": "../backend/.venv/bin/python ../backend/tools/accuracy_report.py",
    "e2e": "node tools/e2e/run.mjs",
    "fusion:parity": "node tools/fusion-parity.mjs",
    "apk": "node tools/apk.mjs",
    "demo:laptop": "E2E_HEADFUL=1 node tools/e2e/run.mjs fusion_demo",
    "demo:reset": "../backend/.venv/bin/python ../backend/tools/demo_reset.py",
    "prebuild:prod": "node scripts/copy-mediapipe.mjs",
    "build:prod": "export VITE_API_URL=/api VITE_DEMO_TOOLS= && vite build && node tools/build-info.mjs",
    "e2e:public": "node tools/e2e/public.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3"
  }
}
